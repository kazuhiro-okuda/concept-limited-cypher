rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /roulette_items/{itemId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner() {
        // createdBy が無い古い項目は誰の物でもない扱い
        return resource.data.get('createdBy', null) == request.auth.uid;
      }
      function validTitle() {
        return request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 50;
      }

      // 誰でも読める
      allow read: if true;

      // サインイン済み（ゲスト含む）なら、自分名義で追加できる
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && validTitle();

      // 編集：作成者本人のみ。持ち主（createdBy）は書き換え不可
      allow update: if isSignedIn() && isOwner()
        && request.resource.data.createdBy == resource.data.createdBy
        && validTitle();

      // 削除：作成者本人のみ
      allow delete: if isSignedIn() && isOwner();
    }
    // それ以外のコレクションはすべて拒否
  }
}
